function saveCal(){
  const date=document.getElementById('cal-date').value;
  const school=document.getElementById('cal-school').value.trim();
  if(!date||!school){alert('請填寫日期與學校');return;}
  const dt=new Date(date);
  const roc=dt.getFullYear()-1911;
  const m=String(dt.getMonth()+1).padStart(2,'0');
  const d=String(dt.getDate()).padStart(2,'0');
  const teachers=T.filter(t=>document.getElementById('ctp-'+t.id)?.checked).map(t=>t.name);
  const ev={
    id: editCalId||'ce'+Date.now(),
    semester: document.getElementById('cal-sem').value,
    date, dateStr:`${roc}/${m}/${d}`,
    day: document.getElementById('cal-day').value,
    time: document.getElementById('cal-time').value,
    school,
    type: document.getElementById('cal-type').value,
    classNum: document.getElementById('cal-class').value,
    people: document.getElementById('cal-people').value,
    note: document.getElementById('cal-note').value,
    teachers,
  };
  if(editCalId){
    const idx=calEvents.findIndex(e=>e.id===editCalId);
    if(idx>=0)calEvents[idx]=ev;
  } else {
    calEvents.push(ev);
  }
  sortCal();
  document.getElementById('mc').classList.remove('show');
  renderCal();
}

