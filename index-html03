function parseTeacherImport(raw){
  const rows=raw.trim().split('\n').map(r=>r.split('\t').map(c=>c.trim()));
  const dataRows=rows.filter(r=>{
    if(!r[0])return false;
    const h=r[0].toLowerCase();
    return !h.includes('老師姓名')&&!h.includes('name')&&!h.startsWith('※')&&!h.startsWith('注意')&&!h.startsWith('am')&&!h.startsWith('pm')&&!h.startsWith('星期');
  });
  // 依老師姓名分組
  const map={};
  dataRows.forEach(r=>{
    const name=(r[0]||'').trim();
    const subject=(r[1]||'').trim();
    const day=parseInt(r[2])||0;
    const perRaw=(r[3]||'').trim().toLowerCase().replace(/\s/g,'');
    const course=(r[4]||'').trim();
    const cls=(r[5]||'').trim();
    if(!name||!day||!perRaw)return;
    const perId=PER_IDS[perRaw]||PER_IDS[r[3]]||null;
    if(!perId)return;
    if(!map[name]){map[name]={name,subject,schedule:{}};}
    if(subject&&!map[name].subject) map[name].subject=subject;
    const key=`${day}_${perId}`;
    map[name].schedule[key]=`${course||subject}\n${cls}`;
  });
  return Object.values(map);
}

