function getSelPeriods(){
  return PER.filter(p=>document.getElementById('pc-'+p.id)&&document.getElementById('pc-'+p.id).checked);
}

function isHS3(val){
  // 判斷是否為高三課程
  return val && (val.includes('高三') || val.includes('三年'));
}

function rq(){
  const aff=getSelPeriods();
  if(!aff.length){alert('請至少勾選一個節次');return;}
  
  const avail=[],adjustable=[],busy=[];
  T.forEach(t=>{
    const busySlots=aff.filter(p=>t.schedule[`${selDay}_${p.id}`]);
    if(!busySlots.length){
      avail.push(t);
    } else {
      // 檢查有課的節次是否全為高三課程（可調課）
      const allHS3=busySlots.every(p=>isHS3(t.schedule[`${selDay}_${p.id}`]));
      if(allHS3) adjustable.push({...t,busySlots});
      else busy.push({...t,busySlots});
    }
  });

  const dn=['','一','二','三','四','五','六'][selDay];
  const periodLabels=aff.map(p=>p.label).join('、');
  const qd=document.getElementById('qdate').value;
  const dateLabel=qd?fmtDate(qd):`週${dn}`;
  let html=`<div style="font-size:13px;color:#185fa5;font-weight:600;margin-bottom:12px;padding:10px 14px;background:#e6f1fb;border-radius:8px;border:1px solid #b5d4f4">📅 ${dateLabel}・${periodLabels}</div>`;

  html+=`<p class="sl" style="color:#3b6d11">✓ 完全空堂（${avail.length} 位）</p>`;
  if(!avail.length) html+='<div class="es" style="padding:1rem">此時段無完全空堂老師</div>';
  avail.forEach(t=>{
    const isSel=selT.includes(t.id);
    html+=`<div class="ri ${isSel?'selected':'available'}">
      <div>
        <span style="font-size:14px;font-weight:600">${t.name} 老師</span>
        <span style="font-size:12px;color:#666;margin-left:6px">${t.subject}</span>
      </div>
      <div style="display:flex;gap:6px">
        <button class="btn-sm" onclick="oV('${t.id}')">檢視課表</button>
        <button class="btn-sm" onclick="tSel('${t.id}')" style="${isSel?'border-color:#378add;color:#185fa5;font-weight:600':''}">${isSel?'✓ 已選':'選取'}</button>
      </div>
    </div>`;
  });

  if(adjustable.length){
    html+=`<p class="sl" style="color:#b85c00;margin-top:16px">🔄 高三課程可調課（${adjustable.length} 位）</p>`;
    adjustable.forEach(t=>{
      const isSel=selT.includes(t.id);
      const slots=t.busySlots.map(p=>{const v=t.schedule[`${selDay}_${p.id}`]||'';const pts=v.split('\n');return `${p.label}：${pts[0]} ${pts[1]||''}`;}).join('、');
      html+=`<div class="ri ${isSel?'selected':''}" style="${!isSel?'border-color:#f5a623;background:#fffbea':''}">
        <div>
          <span style="font-size:14px;font-weight:600">${t.name} 老師</span>
          <span style="font-size:12px;color:#666;margin-left:6px">${t.subject}</span>
          <div style="font-size:11px;color:#b85c00;margin-top:3px">${slots}</div>
        </div>
        <div style="display:flex;gap:6px">
          <button class="btn-sm" onclick="oV('${t.id}')">檢視課表</button>
          <button class="btn-sm" onclick="tSel('${t.id}')" style="${isSel?'border-color:#378add;color:#185fa5;font-weight:600':'border-color:#f5a623;color:#b85c00'}">${isSel?'✓ 已選':'選取'}</button>
        </div>
      </div>`;
    });
  }

  if(busy.length){
    html+=`<p class="sl" style="color:#888;margin-top:16px">✗ 有課無法配合（${busy.length} 位）</p>`;
    busy.forEach(t=>{
      const slots=t.busySlots.map(p=>{const v=t.schedule[`${selDay}_${p.id}`]||'';const pts=v.split('\n');return `${p.label}：${pts[0]} ${pts[1]||''}`;}).join('、');
      html+=`<div class="ri unavailable">
        <div>
          <span style="font-size:14px;font-weight:600">${t.name} 老師</span>
          <span style="font-size:12px;color:#666;margin-left:6px">${t.subject}</span>
          <div style="font-size:11px;color:#999;margin-top:3px">${slots}</div>
        </div>
        <div style="display:flex;gap:6px;align-items:center">
          <button class="btn-sm" onclick="oV('${t.id}')">檢視課表</button>
          <span style="font-size:11px;color:#a32d2d;background:#fcebeb;padding:2px 8px;border-radius:20px">有課</span>
        </div>
      </div>`;
    });
  }

  document.getElementById('qr').innerHTML=html;
  uSB();
}
