function sw(tab,btn){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('page-'+tab).classList.add('active');
  // 固定列印按鈕只在出差單頁顯示
  const fp=document.getElementById('float-print');
  if(fp) fp.style.display=(tab==='export')?'flex':'none';
}
function syncDayFromDate(){
  const val=document.getElementById('qdate').value;
  if(!val) return;
  const dt=new Date(val);
  const dow=dt.getDay(); // 0=日
  const roc=dt.getFullYear()-1911;
  const m=String(dt.getMonth()+1).padStart(2,'0');
  const d=String(dt.getDate()).padStart(2,'0');
  const wNames=['日','一','二','三','四','五','六'];
  const disp=document.getElementById('date-display');
  if(dow===0){
    disp.textContent='⚠️ 所選日期為星期日，請確認';
    disp.style.background='#fcebeb';disp.style.color='#a32d2d';
    disp.style.display='block';
    return;
  }
  disp.textContent=`${roc} 年 ${m} 月 ${d} 日（週${wNames[dow]}）`;
  disp.style.background='#e6f1fb';disp.style.color='#185fa5';
  disp.style.display='block';
  sd(dow); // 自動切換星期按鈕
  // 同步帶入出差單日期
  document.getElementById('fd').value=val;
}
function sd(d){
  selDay=d;
  document.querySelectorAll('[id^=day-]').forEach(b=>b.classList.remove('active'));
  document.getElementById('day-'+d).classList.add('active');
}

