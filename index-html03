<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>大明高中 招生宣導系統</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Microsoft JhengHei','Noto Sans TC',sans-serif;color:#1a1a1a;background:#f8f8f6;font-size:15px}
.wrap{max-width:900px;margin:0 auto;padding:1rem}
.header{display:flex;align-items:center;gap:12px;margin-bottom:1.5rem;padding:1rem 1.25rem;background:#fff;border-radius:12px;border:1px solid #e5e5e0}
.header-icon{width:40px;height:40px;border-radius:50%;background:#f1efe8;display:flex;align-items:center;justify-content:center;font-size:18px}
.tabs{display:flex;gap:0;margin-bottom:1.5rem;border-bottom:2px solid #e5e5e0}
.tab{padding:10px 20px;font-size:14px;cursor:pointer;border:none;background:none;color:#888;border-bottom:3px solid transparent;margin-bottom:-2px;font-family:inherit;font-weight:500}
.tab:hover{color:#1a1a1a}
.tab.active{color:#1a1a1a;border-bottom:3px solid #1a1a1a}
.page{display:none}.page.active{display:block}
h2{font-size:16px;font-weight:600;margin-bottom:1rem}
.card{background:#fff;border:1px solid #e5e5e0;border-radius:12px;padding:1rem 1.25rem;margin-bottom:1rem}
label{font-size:13px;color:#666;display:block;margin-bottom:5px}
input[type=text],input[type=date],input[type=time],textarea{width:100%;padding:8px 10px;border:1px solid #d5d3ca;border-radius:8px;font-size:14px;font-family:inherit;outline:none;margin-bottom:10px}
input:focus,textarea:focus{border-color:#888}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
button{cursor:pointer;font-size:13px;font-family:inherit}
.btn-primary{background:#1a1a1a;color:#fff;border:none;padding:9px 20px;border-radius:8px;font-size:14px;font-family:inherit}
.btn-primary:hover{background:#333}
.btn-outline{background:#fff;border:1px solid #d5d3ca;padding:8px 16px;border-radius:8px;color:#1a1a1a}
.btn-outline:hover{background:#f8f8f6}
.btn-sm{padding:5px 11px;font-size:12px;border-radius:7px;border:1px solid #d5d3ca;background:#fff;color:#1a1a1a}
.btn-sm:hover{background:#f8f8f6}
.btn-danger{background:#fff;border:1px solid #f09595;padding:5px 11px;border-radius:7px;font-size:12px;color:#a32d2d}
.btn-danger:hover{background:#fcebeb}
.sg{display:grid;grid-template-columns:75px repeat(6,1fr);gap:2px;font-size:11px}
.sg-h{background:#f1efe8;padding:5px 3px;text-align:center;font-weight:600;border-radius:4px;font-size:11px}
.sg-t{background:#f1efe8;padding:4px 3px;text-align:center;border-radius:4px;font-size:10px;color:#666;line-height:1.4}
.sg-c{border:1px solid #e5e5e0;border-radius:4px;min-height:50px;display:flex;align-items:center;justify-content:center;padding:2px}
.sg-c.busy{background:#eaf3de;border-color:#97c459}
.sg-c.empty{background:#fff}
.ct{font-size:9px;text-align:center;color:#27500a;line-height:1.3}
.cc{font-size:8px;color:#3b6d11}
.ti{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border:1px solid #e5e5e0;border-radius:10px;margin-bottom:8px;background:#fff}
.ri{padding:10px 14px;border:1px solid #e5e5e0;border-radius:10px;display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;background:#fff}
.ri.available{border-color:#97c459;background:#eaf3de}
.ri.selected{border-color:#378add;background:#e6f1fb}
.ri.unavailable{opacity:0.55}
.sb{padding:7px 12px;border:1px solid #d5d3ca;border-radius:8px;background:#fff;cursor:pointer;font-size:13px;font-family:inherit}
.sb:hover{background:#f8f8f6}
.sb.active{border-color:#378add;background:#e6f1fb;color:#185fa5;font-weight:500}
.overlay{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:flex-start;justify-content:center;padding-top:40px;overflow-y:auto}
.overlay.show{display:flex}
.modal{background:#fff;border-radius:14px;padding:1.5rem;width:680px;max-width:95vw;max-height:85vh;overflow-y:auto;margin:auto}
.es{text-align:center;padding:2.5rem;color:#888;font-size:14px}
.tag{display:inline-block;font-size:12px;padding:3px 10px;border-radius:20px;margin:2px;background:#f1efe8;color:#555}
.sl{font-size:13px;font-weight:600;margin:14px 0 8px}
.info-bar{background:#e6f1fb;border:1px solid #b5d4f4;border-radius:8px;padding:10px 14px;font-size:13px;color:#185fa5;margin-bottom:1rem}
</style>
</head>
<body>
<div class="wrap">
<div class="header">
  <div class="header-icon">🏫</div>
  <div>
    <p style="font-weight:600;font-size:16px">大明高中 招生宣導系統</p>
    <p style="font-size:12px;color:#888">課表管理 · 空堂查詢 · 出差單 · 行事曆</p>
  </div>
  <div style="margin-left:auto;display:flex;align-items:center;gap:12px">
    <span id="save-status" style="font-size:11px;color:#888"></span>
    <span style="font-size:12px;color:#888">共 <span id="tc2">33</span> 位老師</span>
  </div>
</div>

<div class="tabs">
  <button class="tab active" onclick="sw('teachers',this)">📋 老師課表</button>
  <button class="tab" onclick="sw('query',this)">🔍 空堂查詢</button>
  <button class="tab" onclick="sw('export',this)">📄 出差單</button>
  <button class="tab" onclick="sw('calendar',this)">📅 行事曆</button>
</div>

<!-- PAGE 1 -->
<div class="page active" id="page-teachers">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
    <h2 style="margin:0">老師課表（<span id="tc">33</span> 位）</h2>
    <div style="display:flex;gap:8px">
      <button class="btn-outline" onclick="openTeacherImport()" style="font-size:13px">📥 批次匯入</button>
      <button class="btn-primary" onclick="openAdd()">＋ 新增老師</button>
    </div>
  </div>
  <div style="position:relative;margin-bottom:1rem">
    <input type="text" id="search-teacher" placeholder="🔍 搜尋老師姓名或科目…" oninput="rTL()" style="margin-bottom:0;padding-left:14px">
  </div>
  <div id="tlist"></div>
</div>

<!-- PAGE 2 -->
<div class="page" id="page-query">
  <h2>空堂查詢</h2>
  <div class="card">
    <div style="margin-bottom:14px">
      <label>宣導日期</label>
      <input type="date" id="qdate" style="margin-bottom:8px" onchange="syncDayFromDate()">
      <div id="date-display" style="font-size:13px;color:#185fa5;font-weight:600;padding:6px 10px;background:#e6f1fb;border-radius:7px;display:none"></div>
    </div>
    <div style="margin-bottom:14px">
      <label>星期（由日期自動帶入，亦可手動修改）</label>
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px">
        <button class="sb active" id="day-1" onclick="sd(1)">週一</button>
        <button class="sb" id="day-2" onclick="sd(2)">週二</button>
        <button class="sb" id="day-3" onclick="sd(3)">週三</button>
        <button class="sb" id="day-4" onclick="sd(4)">週四</button>
        <button class="sb" id="day-5" onclick="sd(5)">週五</button>
        <button class="sb" id="day-6" onclick="sd(6)">週六</button>
      </div>
    </div>
    <label>勾選宣導節次（可複選）</label>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:6px;margin-bottom:14px" id="period-checks"></div>
    <div style="font-size:12px;color:#888;margin-bottom:12px;padding:8px 10px;background:#fffbea;border-radius:7px;border:1px solid #ffe58a">
      💡 上課中若為<strong>高三課程</strong>，視為可調課（顯示橘色）
    </div>
    <button class="btn-primary" onclick="rq()" style="width:100%;padding:10px">查詢空堂老師</button>
  </div>
  <div id="qr"></div>
  <div id="selbox" style="display:none">
    <div class="card" style="border-color:#378add;border-width:2px">
      <p style="font-size:13px;font-weight:600;color:#185fa5;margin-bottom:8px">✓ 已選老師</p>
      <div id="seltags"></div>
      <button class="btn-primary" onclick="goExp()" style="margin-top:12px">前往填寫出差單 →</button>
    </div>
  </div>
</div>

<!-- PAGE 3 -->
<div class="page" id="page-export">
  <h2>宣導預訂行程表</h2>
  <div class="card">
    <div style="margin-bottom:10px"><label>日期（民國年）</label><input type="date" id="fd"></div>
    <div style="margin-bottom:10px;position:relative">
      <label>宣導學校</label>
      <input type="text" id="fs" placeholder="輸入學校名稱關鍵字…" autocomplete="off" oninput="schoolSearch()" onblur="setTimeout(hideSchoolDrop,200)" style="margin-bottom:0">
      <div id="school-drop" style="display:none;position:absolute;left:0;right:0;top:100%;background:#fff;border:1px solid #d5d3ca;border-radius:8px;box-shadow:0 4px 16px rgba(0,0,0,0.1);z-index:200;max-height:220px;overflow-y:auto"></div>
    </div>
    <div style="margin-bottom:10px"><label>地址</label><input type="text" id="fa" placeholder="選擇學校後自動填入"></div>
    <div style="margin-bottom:10px"><label>宣導性質</label><input type="text" id="ft" placeholder="例：招生博覽會"></div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:10px">
      <div><label>到達時間</label><input type="text" id="fav" placeholder="例：13:30" style="margin-bottom:0"></div>
      <div><label>使用時間（開始）</label><input type="text" id="fus" placeholder="例：14:00" style="margin-bottom:0"></div>
      <div><label>使用時間（結束）</label><input type="text" id="fue" placeholder="例：16:20" style="margin-bottom:0"></div>
    </div>
    <div style="margin-bottom:10px"><label>宣導教師</label><input type="text" id="fte" placeholder="從查詢頁選取後自動填入"></div>
    <div style="margin-bottom:10px"><label>實施方式</label><textarea id="fm" rows="3" style="resize:vertical">文宣內容：各校沿革、特色、辦學理念、師資陣容、地理環境、硬體設備、入學條件、畢業生就業或升學狀況...等。</textarea></div>
    <div style="margin-bottom:10px"><label>交通</label><input type="text" id="ftr" value="老師開車前往（油料補助）"></div>
    <div style="margin-bottom:0"><label>補充事項</label><textarea id="fn" rows="2" style="resize:vertical;margin-bottom:0">如有困難，請立即知會招生處，以便另行安排</textarea></div>
  </div>
  <div style="display:grid;grid-template-columns:1fr auto;gap:10px;align-items:stretch;margin-bottom:80px">
    <button class="btn-primary" onclick="printExp()" style="padding:12px;font-size:15px">🖨️ 列印出差單（A4）</button>
    <button onclick="clearAll()" style="padding:12px 18px;font-size:14px;background:#fff;border:1px solid #f09595;border-radius:8px;color:#a32d2d;cursor:pointer;font-family:inherit;white-space:nowrap" onmouseover="this.style.background='#fcebeb'" onmouseout="this.style.background='#fff'">🗑️ 清除全部</button>
  </div>
</div>

<!-- 固定列印按鈕 -->
<div id="float-print" style="display:none;position:fixed;bottom:20px;right:20px;z-index:500;display:flex;flex-direction:column;gap:8px;align-items:flex-end">
  <button onclick="printExp()" style="background:#1a1a1a;color:#fff;border:none;padding:12px 20px;border-radius:50px;font-size:14px;font-family:inherit;cursor:pointer;box-shadow:0 4px 16px rgba(0,0,0,0.2)">🖨️ 列印出差單</button>
  <button onclick="clearAll()" style="background:#fff;border:1px solid #f09595;padding:10px 16px;border-radius:50px;font-size:13px;font-family:inherit;cursor:pointer;color:#a32d2d;box-shadow:0 2px 8px rgba(0,0,0,0.1)">🗑️ 清除全部</button>
</div>

<!-- PAGE 4: 行事曆 -->
<div class="page" id="page-calendar">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
    <h2 style="margin:0">宣導行事曆</h2>
    <div style="display:flex;gap:8px">
      <button class="btn-outline" onclick="openImport()" style="font-size:13px">📥 貼上匯入</button>
      <button class="btn-primary" onclick="openCalAdd()">＋ 新增活動</button>
    </div>
  </div>
  <!-- 學期篩選列 -->
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:1rem">
    <span style="font-size:13px;color:#666;white-space:nowrap">篩選學期：</span>
    <button class="sb active" id="sem-all" onclick="filterSem('all')">全部</button>
    <div id="sem-btns" style="display:flex;gap:6px;flex-wrap:wrap"></div>
    <button onclick="openSemManager()" style="padding:5px 10px;border:1px dashed #d5d3ca;border-radius:7px;background:none;font-size:12px;color:#888;cursor:pointer">⚙️ 管理學期</button>
  </div>
  <!-- 批次操作列（勾選後顯示） -->
  <div id="batch-bar" style="display:none;align-items:center;gap:10px;padding:10px 14px;background:#e6f1fb;border:1px solid #b5d4f4;border-radius:10px;margin-bottom:1rem;flex-wrap:wrap">
    <span id="batch-count" style="font-size:13px;font-weight:600;color:#185fa5"></span>
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-left:auto">
      <button onclick="batchChangeSem()" style="padding:6px 12px;background:#fff;border:1px solid #378add;border-radius:7px;font-size:12px;color:#185fa5;cursor:pointer;font-family:inherit">🔀 變更學期</button>
      <button onclick="batchDelete()" style="padding:6px 12px;background:#fff;border:1px solid #f09595;border-radius:7px;font-size:12px;color:#a32d2d;cursor:pointer;font-family:inherit">🗑️ 批次刪除</button>
      <button onclick="clearSelection()" style="padding:6px 12px;background:#fff;border:1px solid #d5d3ca;border-radius:7px;font-size:12px;color:#666;cursor:pointer;font-family:inherit">✕ 取消選取</button>
    </div>
  </div>
  <div style="overflow-x:auto">
    <table id="cal-table" style="width:100%;border-collapse:collapse;font-size:13px;background:#fff;border-radius:12px;overflow:hidden;border:1px solid #e5e5e0">
      <thead>
        <tr style="background:#f1efe8">
          <th style="padding:10px 8px;border:1px solid #e5e5e0;width:36px">
            <input type="checkbox" id="check-all" onchange="toggleAllCal(this.checked)" style="width:15px;height:15px;cursor:pointer">
          </th>
          <th style="padding:10px 8px;border:1px solid #e5e5e0;white-space:nowrap">學期</th>
          <th style="padding:10px 8px;border:1px solid #e5e5e0;white-space:nowrap">日期</th>
          <th style="padding:10px 8px;border:1px solid #e5e5e0;white-space:nowrap">星期</th>
          <th style="padding:10px 8px;border:1px solid #e5e5e0;white-space:nowrap">時間</th>
          <th style="padding:10px 8px;border:1px solid #e5e5e0;white-space:nowrap">學校</th>
          <th style="padding:10px 8px;border:1px solid #e5e5e0;white-space:nowrap">活動類型</th>
          <th style="padding:10px 8px;border:1px solid #e5e5e0;white-space:nowrap">班級數</th>
          <th style="padding:10px 8px;border:1px solid #e5e5e0;white-space:nowrap">人數</th>
          <th style="padding:10px 8px;border:1px solid #e5e5e0;white-space:nowrap">備註</th>
          <th style="padding:10px 8px;border:1px solid #e5e5e0;white-space:nowrap">指派老師</th>
          <th style="padding:10px 8px;border:1px solid #e5e5e0;white-space:nowrap">操作</th>
        </tr>
      </thead>
      <tbody id="cal-body">
        <tr><td colspan="12" style="text-align:center;padding:2rem;color:#888">尚無活動，點右上角新增或使用「貼上匯入」</td></tr>
      </tbody>
    </table>
  </div>
</div>
</div>

<!-- 批次變更學期 Modal -->
<div class="overlay" id="mbatch">
<div class="modal" style="width:400px">
  <p style="font-size:16px;font-weight:600;margin-bottom:1rem">🔀 變更學期</p>
  <p style="font-size:13px;color:#666;margin-bottom:12px" id="batch-sem-desc"></p>
  <label style="font-size:13px;color:#666;display:block;margin-bottom:6px">將選取的活動移至：</label>
  <select id="batch-sem-select" style="width:100%;padding:9px 10px;border:1px solid #d5d3ca;border-radius:8px;font-size:14px;font-family:inherit;outline:none;margin-bottom:0;background:#fff"></select>
  <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:1.25rem">
    <button class="btn-outline" onclick="document.getElementById('mbatch').classList.remove('show')">取消</button>
    <button class="btn-primary" onclick="doBatchChangeSem()">確認變更</button>
  </div>
</div>
</div>

<!-- 管理學期 Modal -->
<div class="overlay" id="msem">
<div class="modal" style="width:460px">
  <p style="font-size:16px;font-weight:600;margin-bottom:1rem">⚙️ 管理學期</p>
  <div style="margin-bottom:12px">
    <div style="display:flex;gap:8px;margin-bottom:8px">
      <input type="text" id="sem-new-input" placeholder="例：114學年第2學期" style="margin-bottom:0;flex:1">
      <button class="btn-primary" onclick="addSem()" style="white-space:nowrap">新增</button>
    </div>
    <div id="sem-list" style="display:flex;flex-direction:column;gap:6px;max-height:240px;overflow-y:auto"></div>
  </div>
  <div style="text-align:right">
    <button class="btn-outline" onclick="document.getElementById('msem').classList.remove('show')">關閉</button>
  </div>
</div>
</div>

<!-- 匯入 Modal -->
<div class="overlay" id="mi">
<div class="modal" style="width:640px">
  <p style="font-size:16px;font-weight:600;margin-bottom:6px">📥 貼上匯入</p>
  <p style="font-size:12px;color:#888;margin-bottom:10px">從 Excel 或 Google 試算表複製資料後直接貼到下方，欄位順序：<strong>日期、星期、時間、學校、活動類型、班級數、人數、備註、指派老師</strong></p>
  <div style="background:#e6f1fb;border:1px solid #b5d4f4;border-radius:8px;padding:10px 14px;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between">
    <span style="font-size:13px;color:#185fa5">📄 不知道格式？先下載範本填寫</span>
    <button onclick="downloadTemplate()" style="background:#185fa5;color:#fff;border:none;padding:6px 14px;border-radius:7px;font-size:12px;cursor:pointer;font-family:inherit">⬇️ 下載 Excel 範本</button>
  </div>
  <textarea id="import-text" rows="10" style="width:100%;padding:10px;border:1px solid #d5d3ca;border-radius:8px;font-size:13px;font-family:inherit;resize:vertical;margin-bottom:10px" placeholder="在此貼上從試算表複製的資料（不含標題列）..."></textarea>
  <div id="import-preview" style="display:none;margin-bottom:12px">
    <p style="font-size:13px;font-weight:600;color:#3b6d11;margin-bottom:6px" id="import-count"></p>
    <div style="max-height:180px;overflow-y:auto;border:1px solid #d5d3ca;border-radius:8px;font-size:12px" id="import-preview-table"></div>
  </div>
  <div style="display:flex;gap:8px;justify-content:space-between">
    <button onclick="previewImport()" class="btn-outline">預覽解析結果</button>
    <div style="display:flex;gap:8px">
      <button class="btn-outline" onclick="document.getElementById('mi').classList.remove('show');document.getElementById('import-text').value='';document.getElementById('import-preview').style.display='none'">取消</button>
      <button class="btn-primary" onclick="doImport()">確認匯入</button>
    </div>
  </div>
</div>
</div>

<!-- 查看課表 Modal -->
<div class="overlay" id="mv">
<div class="modal">
  <p style="font-size:16px;font-weight:600;margin-bottom:1rem" id="vt"></p>
  <div class="sg" id="vg"></div>
  <div style="text-align:right;margin-top:1.25rem"><button class="btn-outline" onclick="document.getElementById('mv').classList.remove('show')">關閉</button></div>
</div>
</div>

<!-- 老師課表匯入 Modal -->
<div class="overlay" id="mti">
<div class="modal" style="width:660px">
  <p style="font-size:16px;font-weight:600;margin-bottom:6px">📥 批次匯入老師課表</p>
  <p style="font-size:12px;color:#888;margin-bottom:10px">每列代表一個課格，欄位順序：<strong>老師姓名、科目、星期（1-6）、節次（am1-am4 / pm5-pm8）、課程名稱、班級</strong></p>
  <div style="background:#e6f1fb;border:1px solid #b5d4f4;border-radius:8px;padding:10px 14px;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between">
    <div>
