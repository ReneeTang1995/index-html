function doTeacherImport(){
  const raw=document.getElementById('ti-text').value;
  if(!raw.trim()){alert('請先貼上資料');return;}
  const parsed=parseTeacherImport(raw);
  if(!parsed.length){alert('解析不到有效資料，請確認格式');return;}
  const mode=document.querySelector('input[name="ti-mode"]:checked').value;
  if(mode==='replace'){
    if(!confirm(`確定要清除所有 ${T.length} 位現有老師並重新匯入？`))return;
    T.length=0;
  }
  let added=0,updated=0;
  parsed.forEach(imp=>{
    const idx=T.findIndex(x=>x.name===imp.name);
    if(idx>=0){
      T[idx].subject=imp.subject||T[idx].subject;
      // 合併課表（匯入的覆蓋同一格）
      T[idx].schedule=Object.assign({},T[idx].schedule,imp.schedule);
      updated++;
    } else {
      T.push({id:'t'+Date.now()+Math.random(),name:imp.name,subject:imp.subject,schedule:imp.schedule});
      added++;
    }
  });
  closeTeacherImport();
  rTL();
  alert(`✅ 匯入完成！新增 ${added} 位 · 更新 ${updated} 位`);
}

// ── 學期管理 ──
let semesters=['114學年第1學期','114學年第2學期'];
let activeSem='all';

function renderSemBtns(){
  const container=document.getElementById('sem-btns');
  if(!container)return;
  container.innerHTML=semesters.map(s=>`
    <button class="sb ${activeSem===s?'active':''}" onclick="filterSem('${s}')">${s}</button>
  `).join('');
  document.getElementById('sem-all').className='sb '+(activeSem==='all'?'active':'');
  // 更新 modal 的 select
  const sel=document.getElementById('cal-sem');
  if(sel){
    const cur=sel.value;
    sel.innerHTML='<option value="">-- 選擇學期 --</option>'+semesters.map(s=>`<option value="${s}" ${cur===s?'selected':''}>${s}</option>`).join('');
  }
  // 管理學期清單
  const sl=document.getElementById('sem-list');
  if(sl){
    sl.innerHTML=semesters.length?semesters.map((s,i)=>`
      <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border:1px solid #e5e5e0;border-radius:8px;background:#fff">
        <span style="font-size:13px;font-weight:500">${s}</span>
        <div style="display:flex;gap:6px">
          ${i>0?`<button class="btn-sm" onclick="moveSem(${i},-1)">↑</button>`:''}
          ${i<semesters.length-1?`<button class="btn-sm" onclick="moveSem(${i},1)">↓</button>`:''}
          <button class="btn-danger" onclick="delSem(${i})">刪除</button>
        </div>
      </div>`).join(''):'<p style="text-align:center;color:#888;font-size:13px;padding:1rem">尚無學期，請新增</p>';
  }
}

function filterSem(sem){
  activeSem=sem;
  renderSemBtns();
  renderCal();
}

function openSemManager(){
  renderSemBtns();
  document.getElementById('msem').classList.add('show');
}

function addSem(){
  const v=document.getElementById('sem-new-input').value.trim();
  if(!v){alert('請輸入學期名稱');return;}
  if(semesters.includes(v)){alert('學期已存在');return;}
  semesters.push(v);
  document.getElementById('sem-new-input').value='';
  renderSemBtns();
  saveData();
}

function delSem(i){
  if(calEvents.some(e=>e.semester===semesters[i])){
    if(!confirm(`「${semesters[i]}」底下還有活動，刪除學期後這些活動將變為未分類，確定？`))return;
  }
  semesters.splice(i,1);
  renderSemBtns();
  saveData();
}

function moveSem(i,dir){
  const j=i+dir;
  if(j<0||j>=semesters.length)return;
  [semesters[i],semesters[j]]=[semesters[j],semesters[i]];
  renderSemBtns();
  saveData();
}

// ── 批次操作 ──
let selectedIds=new Set();

function toggleSemGroup(cb,ids){
  ids.forEach(id=>{
    if(cb.checked) selectedIds.add(id);
    else selectedIds.delete(id);
  });
  // 更新個別 checkbox
  document.querySelectorAll('.cal-row-check').forEach(b=>{
    if(ids.includes(b.dataset.id)) b.checked=cb.checked;
  });
  updateBatchBar();
}

function updateBatchBar(){
  const bar=document.getElementById('batch-bar');
  const n=selectedIds.size;
  if(n===0){
    bar.style.display='none';
    const ca=document.getElementById('check-all');
    if(ca) ca.checked=false;
  } else {
    bar.style.display='flex';
    document.getElementById('batch-count').textContent=`已選取 ${n} 筆活動`;
  }
}

function toggleCalRow(id,checked){
  if(checked) selectedIds.add(id);
  else selectedIds.delete(id);
  updateBatchBar();
  // 更新全選框狀態
  const allBoxes=document.querySelectorAll('.cal-row-check');
  const ca=document.getElementById('check-all');
  if(ca&&allBoxes.length>0){
    ca.checked=[...allBoxes].every(b=>b.checked);
    ca.indeterminate=[...allBoxes].some(b=>b.checked)&&![...allBoxes].every(b=>b.checked);
  }
}

function toggleAllCal(checked){
  document.querySelectorAll('.cal-row-check').forEach(b=>{
    b.checked=checked;
    if(checked) selectedIds.add(b.dataset.id);
    else selectedIds.delete(b.dataset.id);
  });
  document.getElementById('check-all').indeterminate=false;
  updateBatchBar();
}

function clearSelection(){
  selectedIds.clear();
  document.querySelectorAll('.cal-row-check').forEach(b=>b.checked=false);
  const ca=document.getElementById('check-all');
  if(ca){ca.checked=false;ca.indeterminate=false;}
  updateBatchBar();
}

function batchDelete(){
  if(!selectedIds.size){alert('請先勾選要刪除的活動');return;}
  if(!confirm(`確定刪除選取的 ${selectedIds.size} 筆活動？此操作無法還原`))return;
  calEvents=calEvents.filter(e=>!selectedIds.has(e.id));
  selectedIds.clear();
  renderCal();
  updateBatchBar();
}

function batchChangeSem(){
  if(!selectedIds.size){alert('請先勾選要變更的活動');return;}
  const sel=document.getElementById('batch-sem-select');
  sel.innerHTML=semesters.map(s=>`<option value="${s}">${s}</option>`).join('');
  document.getElementById('batch-sem-desc').textContent=`已選取 ${selectedIds.size} 筆活動`;
  document.getElementById('mbatch').classList.add('show');
}

function doBatchChangeSem(){
  const target=document.getElementById('batch-sem-select').value;
  if(!target)return;
  calEvents.forEach(e=>{if(selectedIds.has(e.id))e.semester=target;});
  document.getElementById('mbatch').classList.remove('show');
  selectedIds.clear();
  sortCal();
  renderCal();
  updateBatchBar();
}

function sortCal(){
  calEvents.sort((a,b)=>{
    const da=a.date||'9999-99-99', db=b.date||'9999-99-99';
    if(da!==db) return da.localeCompare(db);
    return (a.school||'').localeCompare(b.school||'');
  });
}

function renderCal(){
  const tbody=document.getElementById('cal-body');
  if(!calEvents.length){
    tbody.innerHTML='<tr><td colspan="12" style="text-align:center;padding:2rem;color:#888">尚無活動，點右上角新增或使用「貼上匯入」</td></tr>';
    return;
  }
  const filtered=activeSem==='all'?calEvents:calEvents.filter(e=>e.semester===activeSem);
  if(!filtered.length){
    tbody.innerHTML=`<tr><td colspan="12" style="text-align:center;padding:2rem;color:#888">「${activeSem}」尚無活動</td></tr>`;
    return;
  }
  const semOrder={};
  semesters.forEach((s,i)=>semOrder[s]=i);
  const grouped={};
  filtered.forEach(ev=>{
    const sem=ev.semester||'未分類';
    if(!grouped[sem])grouped[sem]=[];
    grouped[sem].push(ev);
  });
  const sortedSems=Object.keys(grouped).sort((a,b)=>{
    const ia=semOrder[a]??999, ib=semOrder[b]??999;
    return ia-ib;
  });
  const semColors=['#1a3a6b','#3b6d11','#7a3b00','#4a1a6b','#006b5a'];
  let html='';
  sortedSems.forEach((sem,si)=>{
    const color=semColors[si%semColors.length];
    const semEvIds=grouped[sem].map(e=>e.id);
    html+=`<tr>
      <td style="background:${color};padding:7px 8px;border:1px solid ${color}">
        <input type="checkbox" onchange="toggleSemGroup(this,${JSON.stringify(semEvIds)})"
          style="width:14px;height:14px;cursor:pointer;filter:invert(1)" class="sem-group-check" data-sem="${sem}">
      </td>
      <td colspan="11" style="background:${color};color:#fff;padding:7px 10px;font-size:12px;font-weight:600;letter-spacing:1px">📅 ${sem}</td>
    </tr>`;
    grouped[sem].forEach(ev=>{
      const isSel=selectedIds.has(ev.id);
      html+=`<tr style="border-bottom:1px solid #e5e5e0;background:${isSel?'#eef5ff':'#fff'}">
        <td style="padding:8px 8px;border:1px solid #e5e5e0;text-align:center">
          <input type="checkbox" class="cal-row-check" data-id="${ev.id}"
            ${isSel?'checked':''} onchange="toggleCalRow('${ev.id}',this.checked)"
            style="width:15px;height:15px;cursor:pointer">
        </td>
        <td style="padding:8px 8px;border:1px solid #e5e5e0;white-space:nowrap">
          <span style="font-size:11px;padding:2px 7px;border-radius:10px;background:${color}22;color:${color};border:1px solid ${color}55">${ev.semester||'未分類'}</span>
        </td>
        <td style="padding:8px 8px;border:1px solid #e5e5e0;white-space:nowrap;font-weight:600">${ev.dateStr}</td>
        <td style="padding:8px 8px;border:1px solid #e5e5e0;text-align:center">${ev.day}</td>
        <td style="padding:8px 8px;border:1px solid #e5e5e0;white-space:nowrap">${ev.time||'—'}</td>
        <td style="padding:8px 8px;border:1px solid #e5e5e0;font-weight:500">${ev.school}</td>
        <td style="padding:8px 8px;border:1px solid #e5e5e0">${ev.type||'—'}</td>
        <td style="padding:8px 8px;border:1px solid #e5e5e0;text-align:center">${ev.classNum||'—'}</td>
        <td style="padding:8px 8px;border:1px solid #e5e5e0;text-align:center">${ev.people||'—'}</td>
        <td style="padding:8px 8px;border:1px solid #e5e5e0">${ev.note||'—'}</td>
        <td style="padding:8px 8px;border:1px solid #e5e5e0">${ev.teachers.length?ev.teachers.join('、'):'—'}</td>
        <td style="padding:8px 8px;border:1px solid #e5e5e0;white-space:nowrap">
          <div style="display:flex;gap:4px">
            <button class="btn-sm" onclick="calToExportFromRow('${ev.id}')">填出差單</button>
            <button class="btn-sm" onclick="editCal('${ev.id}')">編輯</button>
            <button class="btn-danger" onclick="delCal('${ev.id}')">刪除</button>
          </div>
        </td>
      </tr>`;
    });
  });
  tbody.innerHTML=html;
  // 還原勾選狀態後更新全選框
  const ca=document.getElementById('check-all');
  const allBoxes=document.querySelectorAll('.cal-row-check');
  if(ca&&allBoxes.length>0){
    ca.checked=[...allBoxes].every(b=>b.checked);
    ca.indeterminate=[...allBoxes].some(b=>b.checked)&&![...allBoxes].every(b=>b.checked);
  }
}

