  const headers=['日期','星期','時間','學校','活動類型','班級數','人數','備註','指派老師'];
  const examples=[
    ['5月18日','一','14:00～16:00','大墩國民中學','博覽會','10班','230','',''],
    ['5月19日','二','13:30～16:20','豐南國民中學','入班宣導','16班','385','派8人','黃文麗、廖柏宇'],
