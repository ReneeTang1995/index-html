  'pm5':'pm5','pm6':'pm6','pm7':'pm7','pm8':'pm8',
  '0':'am0','1':'am1','2':'am2','3':'am3','4':'am4',
  '5':'pm5','6':'pm6','7':'pm7','8':'pm8',
  '自主':'am0','自主學習':'am0',
  '第1節':'am1','第2節':'am2','第3節':'am3','第4節':'am4',
  '第5節':'pm5','第6節':'pm6','第7節':'pm7','第8節':'pm8',
};

function downloadTeacherTemplate(){
  const BOM='\uFEFF';
  const headers=['老師姓名','科目','星期(1=週一,6=週六)','節次代號','課程名稱','班級'];
  const examples=[
    ['王小明','數學','1','am1','數學A','高二1'],
    ['王小明','數學','1','am2','數學A','高二1'],
    ['王小明','數學','2','pm5','數學甲','高三1'],
    ['王小明','數學','3','am3','應用數學','廣三2'],
    ['李美玲','英語文','1','am1','英語文','多一1'],
    ['李美玲','英語文','2','am3','旅遊英文','高三1'],
    ['','','','','',''],
    ['※ 節次代號說明','','','','',''],
    ['am0=自主學習','am1=第1節08:00','am2=第2節09:00','am3=第3節10:00','am4=第4節11:00',''],
    ['pm5=第5節13:00','pm6=第6節14:00','pm7=第7節15:00','pm8=第8節16:05','',''],
    ['星期','1=週一','2=週二','3=週三','4=週四','5=週五 / 6=週六'],
    ['注意','每個有課時段填一列','同一老師填多列','班級如「高一1」「廣三2」','',''],
  ];
  const rows=[headers,...examples].map(r=>r.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(','));
  const csv=BOM+rows.join('\n');
  const blob=new Blob([csv],{type:'text/csv;charset=utf-8'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='大明高中老師課表範本.csv';
  a.click();
}

