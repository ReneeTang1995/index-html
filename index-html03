// ── 資料持久化（localStorage）──
const STORAGE_KEY='daming_system_v1';

function saveData(){
  try{
    const data={
      teachers: T,
      calEvents,
      semesters,
      savedAt: new Date().toISOString(),
    };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    // 顯示儲存狀態
    const el=document.getElementById('save-status');
    if(el){
      const now=new Date();
      const pad=n=>String(n).padStart(2,'0');
      el.textContent=`💾 已儲存 ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
      el.style.color='#3b6d11';
      clearTimeout(el._t);
      el._t=setTimeout(()=>{el.style.color='#888';},3000);
    }
  } catch(e){
    const el=document.getElementById('save-status');
    if(el){el.textContent='⚠️ 儲存失敗';el.style.color='#a32d2d';}
    console.warn('儲存失敗：',e);
  }
}

function loadData(){
  try{
    const raw=localStorage.getItem(STORAGE_KEY);
    if(!raw) return false;
    const data=JSON.parse(raw);
    if(data.teachers&&Array.isArray(data.teachers)&&data.teachers.length){
      T.length=0;
      data.teachers.forEach(t=>T.push(t));
    }
    if(data.calEvents&&Array.isArray(data.calEvents)){
      calEvents.length=0;
      data.calEvents.forEach(e=>calEvents.push(e));
    }
    if(data.semesters&&Array.isArray(data.semesters)&&data.semesters.length){
      semesters.length=0;
      data.semesters.forEach(s=>semesters.push(s));
    }
    return data.savedAt||true;
  } catch(e){
    console.warn('載入失敗：',e);
    return false;
  }
}

// 在每次資料有變動的函數後自動儲存
// 包裝 savT、dT、saveCal、delCal、doImport、doTeacherImport
// 用 Proxy 方式在關鍵操作後觸發
function autoSaveAfter(fn){
  return function(...args){
    const result=fn.apply(this,args);
    saveData();
    return result;
  };
}

