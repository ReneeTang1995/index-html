// 監聽所有會改變資料的操作，自動觸發儲存
// 用 MutationObserver 偵測 tlist 和 cal-body 變化即觸發存檔
const _autoSaveTargets=['tlist','cal-body'];
_autoSaveTargets.forEach(id=>{
  const el=document.getElementById(id);
