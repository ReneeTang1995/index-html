function parseImportText(raw){
  const rows=raw.trim().split('\n').map(r=>r.split('\t').map(c=>c.trim()));
  // 跳過標題列
  const dataRows=rows.filter(r=>{
    if(!r[0])return false;
    const h=r[0].toLowerCase();
    return !h.includes('日期')&&!h.includes('date');
  });
  return dataRows.map(r=>{
    const dateRaw=r[0]||'';
    // 解析日期：支援「5月18日」「5/18」「5/19 / 5/25」等格式
    let dateStr=dateRaw;
    // 取第一個日期（含「/」分隔的多日期只取第一個）
    const firstDate=dateRaw.split('/')[0].replace(/\s/g,'').split('、')[0];
    // 轉換「5月18日」→ 格式化字串
    const mDay=firstDate.match(/(\d+)[月\/](\d+)/);
    let isoDate='';
    if(mDay){
      const m=String(mDay[1]).padStart(2,'0');
      const d=String(mDay[2]).padStart(2,'0');
      // 自動判斷年份：若月份已過當前月份，視為下一年
      const now=new Date();
      let yr=now.getFullYear();
      if(parseInt(mDay[1])<now.getMonth()+1) yr++;
      isoDate=`${yr}-${m}-${d}`;
      dateStr=`${mDay[1]}月${parseInt(mDay[2])}日`;
    }
    const day=r[1]||'';
    const dayStr=day?'週'+day.replace(/週/g,'').replace(/\s.*/,''):'';
    // 指派老師：嘗試比對課表老師名字
    const teacherRaw=(r[8]||'').split(/[、,，]/).map(s=>s.trim()).filter(Boolean);
    const matchedTeachers=teacherRaw.map(raw=>{
      // 去掉「老師」後綴再比對
      const name=raw.replace(/老師$/,'').trim();
      const found=T.find(t=>t.name===name||t.name===raw||name.includes(t.name)||t.name.includes(name));
      return found?found.name:raw;
    });
    return {
      id:'ce'+Date.now()+Math.random(),
      semester: activeSem!=='all'?activeSem:(semesters[semesters.length-1]||''),
      date:isoDate,
      dateStr:dateRaw,
      day:dayStr,
      time:r[2]||'',
      school:r[3]||'',
      type:r[4]||'',
      classNum:r[5]||'',
      people:r[6]||'',
      note:r[7]||'',
      teachers:matchedTeachers,
    };
  }).filter(r=>r.school);
}

